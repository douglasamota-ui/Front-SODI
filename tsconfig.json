{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "typeRoots": ["./types", "./node_modules/@types"],
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "utils/*.ts",
    "utils/*.schema.ts",
    "components/*/*.tsx",
    "components/*/*.types.ts",
    "components/*/*.test.ts",
    "/**/*.types.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "svg.d.ts",
    "src/**/*",
    "global.d.ts"
  ]
}
